# Copy the frontend block to a root .env file and the backend block to server/.env.
# Fill in your own Firebase project values. Never commit real .env files or keys.

# --- Frontend (Vite) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# --- Backend (server/.env) ---
PORT=5000
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
CORS_ORIGIN=http://localhost:3000
OWNER_UID=
SHOP_ID=
LEGACY_SINGLE_TENANT_MODE=false
# Production: paste the service account JSON on one line. Keep this secret.
FIREBASE_SERVICE_ACCOUNT=

# --- AI support assistant (backend only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Subscription payments (backend only; blank values keep checkout disabled) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=true
API_PUBLIC_URL=
APP_PUBLIC_URL=
SSLCOMMERZ_BASIC_MONTHLY_PRICE_BDT=
SSLCOMMERZ_BASIC_YEARLY_PRICE_BDT=
SSLCOMMERZ_PRO_MONTHLY_PRICE_BDT=
SSLCOMMERZ_PRO_YEARLY_PRICE_BDT=
