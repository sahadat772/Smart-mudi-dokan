# Copy the frontend block to a root .env file.
# Copy the backend block to server/.env.
# Never commit .env or serviceAccountKey.json.

# --- Frontend (Vite) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=ai-studio-96cf70ad-76e2-4b50-86a6-02248977631a

# --- Backend (server/.env) ---
PORT=5000
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=ai-studio-96cf70ad-76e2-4b50-86a6-02248977631a
# Comma-separated. Add the live site URL before deploy.
CORS_ORIGIN=http://localhost:3000
# Production: paste the service account JSON on one line.
# Local: leave this empty and keep serviceAccountKey.json next to package.json (gitignored).
# FIREBASE_SERVICE_ACCOUNT=
