# Copy the frontend block to a root .env file and the backend block to server/.env.
# Fill in your own Firebase project values. Never commit real .env files or keys.

# --- Frontend (Vite) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIRESTORE_DATABASE_ID=

# --- Backend (server/.env) ---
PORT=5000
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=
CORS_ORIGIN=http://localhost:3000
OWNER_UID=
SHOP_ID=
LEGACY_SINGLE_TENANT_MODE=false
# Production: paste the service account JSON on one line. Keep this secret.
FIREBASE_SERVICE_ACCOUNT=

# --- AI support assistant (backend only) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Manual subscription pricing (backend only; set amounts in BDT) ---
SUBSCRIPTION_BASIC_MONTHLY_PRICE_BDT=
SUBSCRIPTION_BASIC_YEARLY_PRICE_BDT=
SUBSCRIPTION_PRO_MONTHLY_PRICE_BDT=
SUBSCRIPTION_PRO_YEARLY_PRICE_BDT=

# Public payment instructions shown to shop owners.
MANUAL_PAYMENT_BKASH_INSTRUCTIONS=
MANUAL_PAYMENT_NAGAD_INSTRUCTIONS=
MANUAL_PAYMENT_BANK_INSTRUCTIONS=
MANUAL_PAYMENT_CASH_INSTRUCTIONS=

# Comma-separated Firebase Auth UIDs allowed to approve manual subscriptions.
PLATFORM_ADMIN_UIDS=
