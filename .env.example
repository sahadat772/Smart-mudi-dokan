# --- Backend (server/.env) ---
PORT=5000
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=ai-studio-96cf70ad-76e2-4b50-86a6-02248977631a
# Comma-separated. Add the live site URL before deploy.
CORS_ORIGIN=https://smart-mudi-dokan.vercel.app/
# Your Firebase Auth UID for the shop owner account.
OWNER_UID=In5IV8okCTYlzb1IcxzQeXnhLrK2
# Shop identifier stored in custom claims and user docs.
SHOP_ID=default
# Temporary compatibility for a single-shop install with legacy profiles/records
# that do not yet have shopId. Keep false for multi-shop deployments.
LEGACY_SINGLE_TENANT_MODE=false
# Production: paste the service account JSON on one line.
# Local: leave this empty and keep serviceAccountKey.json next to package.json (gitignored).
# FIREBASE_SERVICE_ACCOUNT=

# --- AI support assistant (backend only; do not use a VITE_ prefix) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Subscription payments (backend only; leave blank to disable checkout) ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=true
API_PUBLIC_URL=https://your-api.example.com
APP_PUBLIC_URL=https://smart-mudi-dokan.vercel.app
