rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client writes are fully blocked. All business writes go through Express + Admin SDK.
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      // Users may read only their own profile (role, permissions, mustChangePassword).
      allow read: if isSelf(userId);
      allow write: if false;
    }

    // All other collections: no client access until Phase 2+ APIs replace demo data.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
